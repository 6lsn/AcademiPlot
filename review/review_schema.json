{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ChartReviewResult",
  "type": "object",
  "required": [
    "figure",
    "overall_status",
    "scores",
    "major_issues",
    "minor_issues",
    "recommended_action",
    "suggested_caption",
    "suggested_plot_type"
  ],
  "properties": {
    "figure": {
      "type": "string"
    },
    "overall_status": {
      "type": "string",
      "enum": ["pass", "revise", "manual_review", "reject"]
    },
    "scores": {
      "type": "object",
      "required": [
        "theme_fit",
        "chart_suitability",
        "readability",
        "annotation_quality",
        "caption_consistency",
        "paper_style"
      ],
      "properties": {
        "theme_fit": {"type": "integer", "minimum": 0, "maximum": 100},
        "chart_suitability": {"type": "integer", "minimum": 0, "maximum": 100},
        "readability": {"type": "integer", "minimum": 0, "maximum": 100},
        "annotation_quality": {"type": "integer", "minimum": 0, "maximum": 100},
        "caption_consistency": {"type": "integer", "minimum": 0, "maximum": 100},
        "paper_style": {"type": "integer", "minimum": 0, "maximum": 100}
      },
      "additionalProperties": false
    },
    "major_issues": {
      "type": "array",
      "items": {"type": "string"}
    },
    "minor_issues": {
      "type": "array",
      "items": {"type": "string"}
    },
    "recommended_action": {
      "type": "string"
    },
    "suggested_caption": {
      "type": "string"
    },
    "suggested_plot_type": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
